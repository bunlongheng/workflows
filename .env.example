# Google OAuth (for YouTube, Gmail, Calendar connections)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic API key (for AI processing)
ANTHROPIC_API_KEY=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# VPS server (automations pipeline)
VPS_URL=http://45.79.212.154:3009
VPS_AUTH_TOKEN=

# Stickies API (where AI summaries are posted)
STICKIES_URL=http://localhost:4444
STICKIES_TOKEN=

# CORS origin for SSE stream (set on VPS side, not Vercel)
ALLOWED_ORIGIN=

# Pipeline poll interval in seconds (default 300)
CHECK_INTERVAL_SEC=

# Public app URL (used for OAuth callbacks, MCP)
NEXT_PUBLIC_APP_URL=http://localhost:3008

# transcriptapi.com - hosted transcript fallback (residential proxies, works from VPS)
# Free 100 credits/mo; 1 credit per successful transcript. Get key at transcriptapi.com -> API Keys
TRANSCRIPTAPI_KEY=
# Optional: cookies.txt for yt-dlp to bypass datacenter bot-block (export from logged-in browser)
YOUTUBE_COOKIES_FILE=./data/youtube-cookies.txt

# Route yt-dlp through a residential exit (SSH SOCKS tunnel into M4 over Tailscale)
# so YouTube sees a home IP, not the datacenter. Free + unlimited.
YTDLP_PROXY=socks5://127.0.0.1:1080
